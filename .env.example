# Tvara — local development only. Copy to .env and fill in.
#
# NOTHING HERE REACHES THE WORKER. The Cloudflare Worker reads its secrets from
# Cloudflare, never from a file:
#
#   cd server && wrangler secret put DODO_API_KEY
#   cd server && wrangler secret put SIGNING_KEY      # node tools/genkey.mjs worker-key
#   cd server && wrangler secret put ARCHIVE_SECRET   # openssl rand -base64 32
#
# A secret in a file is one `git add -A` away from being public, and this repo
# ships unminified and open. Cloudflare-held secrets are write-only: not even
# `wrangler secret list` can read one back. Keep it that way.
#
# The signing key lives at ~/.lct-keys/private.pem, outside the repo entirely,
# with an encrypted backup made by `npm run backup-keys`.

# Live Dodo secret key, for local scripts that call Dodo directly.
# Leave unset unless you are actually running one.
DODO_API_KEY=

# Playwright: "chrome" runs your installed Google Chrome instead of the
# bundled Chromium. Not a secret; here because it is the other local override.
PW_CHANNEL=
