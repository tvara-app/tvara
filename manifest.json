{
  "manifest_version": 3,
  "name": "Long Chat Toolkit",
  "version": "0.7.0",
  "description": "Fix slow, laggy AI chats. Speed engine, minimap, search & backup for ChatGPT, Claude, Gemini, DeepSeek, Grok. 100% local, $0 data.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "long-chat-toolkit@tharuntejandhe.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Long Chat Toolkit"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/store.js",
        "lib/license.js",
        "content/adapters.js",
        "content/engine.js",
        "content/minimap.js",
        "content/exporter.js",
        "content/search.js",
        "content/timeline.js",
        "content/outline.js",
        "content/chatcard.js",
        "content/recall.js",
        "content/bridge.js",
        "content/main.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/inject/fiber-times.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "in-chat-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Search the current conversation"
    },
    "open-recall": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Total Recall \u2014 search every chat, every platform"
    },
    "open-bridge": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Context Bridge \u2014 inject past context into your prompt"
    }
  }
}
