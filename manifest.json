{
  "manifest_version": 3,
  "key": "",
  "name": "Tvara: Long AI Chat Speed, Search & Backup",
  "short_name": "Tvara",
  "version": "1.0.3",
  "description": "Keep long AI chats fast, searchable and backed up locally—without deleting messages or sending chat text to us.",
  "permissions": [
    "alarms",
    "identity",
    "storage",
    "unlimitedStorage",
    "downloads",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https://*.googleusercontent.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://tvara.pages.dev/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Tvara"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "lib/store.js",
        "lib/product.js",
        "lib/quota.js",
        "content/adapters.js",
        "content/quota.js",
        "content/engine.js",
        "content/nav.js",
        "content/richtext.js",
        "content/history-loader.js",
        "content/chat-index.js",
        "content/preview.js",
        "content/minimap.js",
        "content/exporter.js",
        "content/search.js",
        "content/place.js",
        "content/timeline.js",
        "content/outline.js",
        "content/chatcard.js",
        "content/indexer.js",
        "content/bridge.js",
        "content/distil.js",
        "content/carry.js",
        "content/tour.js",
        "content/deletion-toast.js",
        "content/main.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/inject/fiber-times.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/inject/quota-probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/quota-boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tvara.pages.dev/thanks*"
      ],
      "js": [
        "content/purchase.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "in-chat-search": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Search the current conversation"
    },
    "open-recall": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Total Recall — search saved chats on supported sites"
    },
    "open-bridge": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Context Bridge — add selected local context to your prompt"
    }
  }
}
